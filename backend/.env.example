# ==============================================================================
# PayBen Fintech Sandbox Environment Configuration
# ZERO PAID SERVICES REQUIRED - Ready to run out of the box with local providers
# ==============================================================================

APP_ENV=development
APP_NAME=PayBen
APP_TAGLINE="Smart Recharge & Multi-Utility Payment Ecosystem"
APP_URL=http://localhost:8000
FRONTEND_URL=http://localhost:5173
APP_SECRET=payben_fintech_sandbox_hmac_secret_2026_xyz

# Database Configuration (MySQL / MariaDB)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=payben_db
DB_USER=root
DB_PASS=
DB_CHARSET=utf8mb4

# Free Sandbox Provider Configuration
# Supported: mock
PAYMENT_PROVIDER=mock

# Free OTP Provider (Local sandbox OTP with transparent verification code in dev response)
# Supported: local
OTP_PROVIDER=local

# Free Email Notifications (Local logging by default; optional Brevo Free Tier if configured)
# Supported: mock, brevo
EMAIL_PROVIDER=mock
BREVO_API_KEY=
BREVO_SENDER_EMAIL=no-reply@payben.com

# Free Telecom & DTH Recharge Provider
# Supported: mock
RECHARGE_PROVIDER=mock

# Free BBPS Utility Bill Payment Provider
# Supported: mock
BILL_PAYMENT_PROVIDER=mock
